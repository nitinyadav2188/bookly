{
  "name": "pagina",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 4321",
    "build": "next build",
    "build:static": "NEXT_OUTPUT_EXPORT=1 next build",
    "start": "next start --port 4321",
    "start:static": "npx --yes serve out -l 4321",
    "lint": "eslint",
    "cap:sync": "npx cap sync android",
    "android:init": "npm run build:static && npx cap add android && npx cap sync android",
    "android:sync": "npm run build:static && npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleDebug && mkdir -p ../public/downloads && cp app/build/outputs/apk/debug/app-debug.apk ../public/downloads/bookly.apk"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/status-bar": "^8.0.3",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.4.1",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "page-flip": "^2.0.7",
    "pdfjs-dist": "^4.10.38",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/page-flip": "^2.0.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "playwright": "^1.55.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
