# Página auth / runtime (copy to `.env.local` for local demo)

# Required — Auth.js session signing secret (generate: `openssl rand -base64 32`)
AUTH_SECRET=

# SQLite database path (file path or `file:./data/pagina.sqlite`)
DATABASE_URL=./data/pagina.sqlite

# Optional — Google OAuth. When unset, the Google button is shown disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — Auth.js / Next URL hints (useful behind proxies)
# AUTH_URL=http://127.0.0.1:4321
